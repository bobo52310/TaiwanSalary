---
import '../styles/global.css';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  title: string;
  description: string;
  /** Path for the canonical URL, e.g. "/rank/median/". Defaults to the current page. */
  canonical?: string;
  /** Site-relative OG image path. Defaults to the shared card. */
  ogImage?: string;
}

const { title, description, canonical, ogImage = '/og-default.png' } = Astro.props;

const SITE_NAME = '哪家給最多';

// Astro.site is set in astro.config.mjs, so this is always absolute.
const canonicalURL = new URL(canonical ?? Astro.url.pathname, Astro.site);

// Only advertise og:image if the asset is really in public/, so a skipped/missing
// card degrades to a plain summary card instead of a broken preview. process.cwd()
// is the project root during `astro build`.
const ogImageExists = existsSync(join(process.cwd(), 'public', ogImage.replace(/^\//, '')));
const ogImageURL = ogImageExists ? new URL(ogImage, Astro.site).href : null;

// Cloudflare Web Analytics beacon token. This is a public value — it ships in
// every page's HTML — so it lives in source directly. Gated to production builds
// (`astro build`) so local `astro dev` traffic never pollutes the stats.
const cfBeaconToken = import.meta.env.PROD ? '5296be06833f40b7aa9b98bf653fd7f3' : null;
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="gWoss9oz-U9v6ggF6wQu_i9NLdMSTcwmChW9YJ9wp9Y" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#fcfcfb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1a19" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    {ogImageURL && <meta property="og:image" content={ogImageURL} />}
    <meta name="twitter:card" content={ogImageURL ? 'summary_large_image' : 'summary'} />
    <!-- Extra head tags (per-page OG/JSON-LD) injected by pages via slot="head". -->
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a href="/" class="site-brand">
          <span class="site-brand-name">哪家給最多</span>
          <span class="site-brand-sub">台灣上市櫃薪資查詢</span>
        </a>
        <nav class="site-nav" aria-label="主要導覽">
          <a href="/rank/median/">排行榜</a>
          <a href="/industry/">產業</a>
          <a href="/about/">關於</a>
        </nav>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-top">
          <div class="footer-brand">
            <span class="footer-brand-name">哪家給最多</span>
            <span class="footer-brand-sub">台灣上市櫃薪資查詢</span>
          </div>
          <nav class="footer-nav" aria-label="頁尾導覽">
            <a href="/">薪資查詢</a>
            <a href="/rank/median/">排行榜</a>
            <a href="/industry/">產業</a>
            <a href="/about/">關於</a>
          </nav>
        </div>
        <div class="footer-meta">
          <span
            >資料來源：<a
              href="https://mopsov.twse.com.tw/mops/web/t100sb15"
              target="_blank"
              rel="noopener">公開資訊觀測站</a
            ></span
          >
          <span>非官方網站，僅供參考。</span>
          <span
            >姊妹站：<a
              href="https://taxmap.bobochen.dev/"
              target="_blank"
              rel="noopener">哪裡最有錢 · 台灣所得地圖</a
            ></span
          >
          <span
            >開源專案：<a
              href="https://github.com/bobo52310/TaiwanSalary"
              target="_blank"
              rel="noopener">GitHub</a
            ></span
          >
          <span
            >由 <a href="https://bobochen.dev/" target="_blank" rel="noopener">Bobo Chen</a> 製作</span
          >
        </div>
      </div>
    </footer>

    {cfBeaconToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: cfBeaconToken })}
      ></script>
    )}
  </body>
</html>
